{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
    "oc-advisor@git+https://github.com/ac5tin/oc-advisor.git",
    "oc-ketch@git+https://github.com/ac5tin/oc-ketch.git",
    "oc-sessions@git+https://github.com/ac5tin/oc-sessions.git",
    "oc-commandcode@git+https://github.com/ac5tin/oc-commandcode.git",
    "ac5tin-skills@git+https://github.com/ac5tin/skills.git"
  ],
  "agents": {
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#high"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "<API_KEY>"
        }
      },
    }
  }
}
